rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /queries/{document=**} {
      // Allow read and create if the user is authenticated and is the owner
      allow read, create: if request.auth != null && request.auth.uid == resource.data.userId || (request.resource != null && request.auth.uid == request.resource.data.userId);
      // Deny update and delete
      allow update, delete: if false;
    }

    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
